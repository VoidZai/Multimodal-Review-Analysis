# Data — large, non-deterministic to re-download; tracked via manifests/hashes instead
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
!data/processed/*_manifest.json
!data/processed/*_datasheet.md

# Photo bytes (T6.1) -- regenerable from image_urls via
# cragb.multimodal.photo_store; the coverage manifest is committed so RQ4's
# coverage numbers are reproducible even if a CDN link later dies.
data/photos/*
!data/photos/.gitkeep
!data/photos/manifest_v1.json

# Fine-tuning data prep (T7.2+) -- regenerable from corpus_v1 + cragb_v1 under
# the same seed; manifests are committed so composition/coverage numbers are
# reproducible without regenerating the (large, synthetic) data itself.
data/finetune/*
!data/finetune/.gitkeep
!data/finetune/*_manifest.json

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Disk-cached API responses (regenerable; PLAN.md §5 caches for
# reproducibility/quota safety, not for committing to git)
results/cache/

# Environments
.venv/
venv/
*.env

# OS
.DS_Store
Thumbs.db

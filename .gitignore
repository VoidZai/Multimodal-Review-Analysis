# Data — large, non-deterministic to re-download; tracked via manifests/hashes instead
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
!data/processed/*_manifest.json
!data/processed/*_datasheet.md

# Photo bytes (T6.1) -- regenerable from image_urls via
# cragb.multimodal.photo_store; the coverage manifest is committed so RQ4's
# coverage numbers are reproducible even if a CDN link later dies.
data/photos/*
!data/photos/.gitkeep
!data/photos/manifest_v1.json

# Fine-tuning data prep (T7.2+) -- regenerable from corpus_v1 + cragb_v1 under
# the same seed; manifests are committed so composition/coverage numbers are
# reproducible without regenerating the (large, synthetic) data itself.
# Pattern is *manifest*.json, not *_manifest.json, because naming isn't
# consistent across tasks: T7.2's is contexts_v1_manifest.json (suffix) but
# T7.6's is split_manifest_v1.json (infix, per M7.md's own artifact name) --
# a stricter suffix-only pattern silently missed the latter until caught here.
data/finetune/*
!data/finetune/.gitkeep
!data/finetune/*manifest*.json
# The Gebru-style datasheet (T7.10) is hand-written prose, not regenerable data -- commit it
# like the manifests above, not like the (large, synthetic, regenerable) JSONL files.
!data/finetune/finetune_data_datasheet.md

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Disk-cached API responses (regenerable; PLAN.md §5 caches for
# reproducibility/quota safety, not for committing to git)
results/cache/

# Environments
.venv/
venv/
*.env

# OS
.DS_Store
Thumbs.db

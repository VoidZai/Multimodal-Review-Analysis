# Copy this file to `.env` and fill in your key(s). `.env` itself is
# git-ignored — never commit real API keys.

# Groq free-tier API key (https://console.groq.com/keys) — used by
# src/cragb/generate/api_clients.py for CRAGB question drafting (T2.2)
# and later grounded-QA / judge calls (E4, E5).
GROQ_API_KEY=

# Google AI Studio (Gemini) free-tier API key (https://aistudio.google.com/apikey)
# — used by src/cragb/generate/gemini_client.py for the multimodal
# vision-evidence judge (T6.2/T6.4, E7/G3/RQ4). Added because no model on
# Groq's catalog accepts image input (PLAN.md §14.4).
GOOGLE_API_KEY=
